{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/mcp",
      "dest": "/api/mcp.ts"
    },
    {
      "src": "/api/mcp/message",
      "dest": "/api/mcp/message.ts"
    },
    {
      "src": "/widget.html",
      "dest": "/public/widget.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
